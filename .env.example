# PlusVibe API Key (начинается с sk-pv-...)
PLUSVIBE_API_KEY=sk-pv-your-api-key-here

# LLM Configuration (OpenAI-compatible, Non-GPT models)
NEBULA_LLM_PROVIDER=plusvibe
NEBULA_LLM_BASE_URL=https://plusvibeapi.ru/v1
NEBULA_LLM_MODEL=google/gemini-3.8-flash
# Альтернативные проверенные модели: deepseek/deepseek-v4-flash-0731, qwen/qwen3.7-plus, z-ai/glm-5.3-flash

# STT Configuration (OpenAI-compatible audio transcriptions)
NEBULA_STT_ENDPOINT=https://plusvibeapi.ru/v1/audio/transcriptions
NEBULA_STT_MODEL=whisper-large-v3-turbo
NEBULA_STT_LANGUAGE=ru
