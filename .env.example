# ==============================================================================
# Nebula AI Configuration / Конфигурация AI Nebula
# ==============================================================================
# Примечание: Настройки провайдеров и моделей теперь можно настраивать прямо
# через экран «Настройки» в Nebula Desktop UI или через API (/api/v1/settings/ai).
# При сохранении настроек в UI параметры хранятся в БД, а ключи — в защищённом
# файле data/provider-secrets-v<rev>.env.
# Значения из переменных окружения имеют высший приоритет для ключей (status=process_environment,
# редактирование через UI заблокировано) и служат начальной конфигурацией по умолчанию (rev 0).
#
# Note: Provider and model settings can now be configured directly via the "Settings"
# screen in Nebula Desktop UI or via API (/api/v1/settings/ai).
# When saved in UI, configuration is stored in DB, and credentials in a protected
# versioned file data/provider-secrets-v<rev>.env.
# Environment variables take precedence for credentials (marked process_environment,
# non-editable via UI) and provide initial defaults (rev 0).

# ------------------------------------------------------------------------------
# Explicit API Keys / Явные API-ключи провайдеров
# ------------------------------------------------------------------------------
# Ключ для сервиса распознавания речи (STT) / API Key for Speech-to-Text (STT)
NEBULA_STT_API_KEY=your-stt-api-key-here

# Ключ для анализа текста и скоринга (LLM) / API Key for Text Analysis & Scoring (LLM)
NEBULA_LLM_API_KEY=your-llm-api-key-here

# ------------------------------------------------------------------------------
# Backward Compatibility Keys / Ключи обратной совместимости
# ------------------------------------------------------------------------------
# RouterAI API Key (fallback if NEBULA_STT_API_KEY / NEBULA_LLM_API_KEY not set)
# Получить в https://routerai.ru/settings/keys
ROUTERAI_API_KEY=your-routerai-api-key-here

# PlusVibe API Key (legacy fallback profile)
# PLUSVIBE_API_KEY=sk-pv-your-api-key-here

# ------------------------------------------------------------------------------
# Default LLM Configuration / Конфигурация LLM по умолчанию (OpenAI-compatible)
# ------------------------------------------------------------------------------
NEBULA_LLM_PROVIDER=routerai
NEBULA_LLM_BASE_URL=https://routerai.ru/api/v1
NEBULA_LLM_MODEL=qwen/qwen3.7-flash
# Альтернативные проверенные модели / Alternative verified models:
# qwen/qwen3.7-plus, deepseek/deepseek-v4-flash-0731, google/gemini-2.5-flash

# ------------------------------------------------------------------------------
# Default STT Configuration / Конфигурация STT по умолчанию (OpenAI-compatible)
# ------------------------------------------------------------------------------
NEBULA_STT_ENDPOINT=https://routerai.ru/api/v1/audio/transcriptions
# Default: openai/gpt-transcribe - chosen for transcription quality on technical Russian
# speech (the cheaper qwen/qwen3-asr-1.7b garbled domain terms, and those strings become
# candidate evidence). Alternatives: qwen/qwen3-asr-1.7b (~10x cheaper),
# whisper-large-v3-turbo (PlusVibe profile, requires PLUSVIBE_API_KEY).
NEBULA_STT_MODEL=openai/gpt-transcribe
NEBULA_STT_LANGUAGE=ru
